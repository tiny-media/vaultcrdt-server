# Required — secret for signing JWT session tokens
VAULTCRDT_JWT_SECRET=

# Required — Admin Token for vault registration
VAULTCRDT_ADMIN_TOKEN=

# Optional — SQLite database path. Default of the bare binary: ./vaultcrdt.db;
# the shipped docker-compose.yml pins /var/lib/vaultcrdt/data.db instead.
# VAULTCRDT_DB_PATH=/var/lib/vaultcrdt/data.db

# Optional — bind address (default: 0.0.0.0:8080)
# VAULTCRDT_BIND=0.0.0.0:8080

# Optional — SQLite connection pool size (default: 5)
# VAULTCRDT_POOL_SIZE=5

# Optional — trust proxy headers for rate limiting (default: off). Set to true
# ONLY when a trusted proxy that sets CF-Connecting-IP authoritatively fronts
# the server; X-Forwarded-For is never trusted (first hop is
# attacker-controllable).
# VAULTCRDT_TRUST_PROXY=true

# Optional — how many days a tombstone is kept before it expires (default: 365).
# Tombstones prevent a deleted document from being resurrected by a device
# that comes back online after a long offline period. The retention window
# must comfortably exceed the longest expected offline gap of any device.
# Increase if devices may stay offline longer than a year. Higher values cost
# a small amount of disk per deleted document and a slightly longer DocList
# payload on first sync.
# VAULTCRDT_TOMBSTONE_DAYS=365

# Optional — how many days a peer's last-seen entry blocks tombstone expiry for
# deletes that peer has not observed yet (default: 365). After retention, the
# peer entry is retired and no longer holds tombstones back.
# VAULTCRDT_PEER_RETENTION_DAYS=365
